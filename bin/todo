#!/usr/bin/env python3
"""Manage a local, Markdown-first daily TODO repository."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import sys
import uuid
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Iterable, Optional


ROOT = Path(__file__).resolve().parent.parent
TYPES_FILE = ROOT / "config" / "task-types.conf"
PRIORITIES_FILE = ROOT / "config" / "priorities.conf"
SCHEMA_FILE = ROOT / "schema" / "task.schema.json"
TODOS_DIR = ROOT / "todos"
TASK_RE = re.compile(
    r"^(?P<indent>\s*)- \[(?P<check>[ xX])\] (?P<name>.+?)"
    r"(?:\s+<!--\s*(?P<meta>.*?)\s*-->)?\s*$"
)
CHECKBOX_RE = re.compile(r"^\s*- \[[ xX]\]")
HEADING_RE = re.compile(r"^##\s+(.+?)\s*$")
SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")


class TodoError(Exception):
    pass


class TaskSchemaValidator:
    """Validate task objects using the JSON Schema keywords used by this repo."""

    def __init__(self, path: Path) -> None:
        self.path = path.resolve()
        self.schema_dir = self.path.parent
        self.documents: dict[Path, dict[str, Any]] = {}
        self.schema = self.load_document(self.path)

    def load_document(self, path: Path) -> dict[str, Any]:
        resolved = path.resolve()
        if not resolved.is_relative_to(self.schema_dir) or resolved.suffix != ".json":
            raise TodoError(f"Schema reference must stay within {self.schema_dir}")
        if resolved not in self.documents:
            try:
                document = json.loads(resolved.read_text())
            except (OSError, json.JSONDecodeError) as exc:
                raise TodoError(f"Cannot load task schema {resolved}: {exc}") from exc
            if not isinstance(document, dict):
                raise TodoError(f"{resolved}: schema document must be an object")
            self.documents[resolved] = document
        return self.documents[resolved]

    def resolve(self, reference: str, document_path: Path) -> tuple[dict[str, Any], Path]:
        if "://" in reference:
            raise TodoError(f"{document_path}: network schema references are not supported")
        file_part, separator, fragment = reference.partition("#")
        if file_part:
            relative = Path(file_part)
            if relative.is_absolute():
                raise TodoError(f"{document_path}: absolute schema references are not supported")
            target_path = (document_path.parent / relative).resolve()
        else:
            target_path = document_path
        current: Any = self.load_document(target_path)
        if not separator or not fragment:
            return current, target_path
        if not fragment.startswith("/"):
            raise TodoError(f"{document_path}: unsupported schema fragment in {reference!r}")
        for raw_part in fragment[1:].split("/"):
            part = raw_part.replace("~1", "/").replace("~0", "~")
            if not isinstance(current, dict) or part not in current:
                raise TodoError(f"{document_path}: unresolved JSON Schema reference {reference!r}")
            current = current[part]
        if not isinstance(current, dict):
            raise TodoError(f"{document_path}: JSON Schema reference {reference!r} is not an object")
        return current, target_path

    def validate(
        self,
        value: Any,
        schema: Optional[dict[str, Any]] = None,
        location: str = "task",
        document_path: Optional[Path] = None,
    ) -> None:
        rule = self.schema if schema is None else schema
        current_document = self.path if document_path is None else document_path
        supported = {
            "$schema", "$id", "$ref", "$defs", "title", "type", "additionalProperties",
            "required", "properties", "pattern", "format", "minLength", "items",
        }
        unsupported = set(rule) - supported
        if unsupported:
            raise TodoError(f"{current_document}: unsupported JSON Schema keywords {sorted(unsupported)}")
        if "$ref" in rule:
            resolved, resolved_path = self.resolve(rule["$ref"], current_document)
            self.validate(value, resolved, location, resolved_path)
            return

        expected = rule.get("type")
        matches = {
            "object": isinstance(value, dict),
            "array": isinstance(value, list),
            "string": isinstance(value, str),
            "boolean": isinstance(value, bool),
            "integer": isinstance(value, int) and not isinstance(value, bool),
        }
        if expected and not matches.get(expected, False):
            raise TodoError(f"{location}: schema requires {expected}, got {type(value).__name__}")

        if expected == "object":
            required = rule.get("required", [])
            missing = [name for name in required if name not in value]
            if missing:
                raise TodoError(f"{location}: schema requires fields {missing}")
            properties = rule.get("properties", {})
            if rule.get("additionalProperties") is False:
                extras = set(value) - set(properties)
                if extras:
                    raise TodoError(f"{location}: schema rejects fields {sorted(extras)}")
            for name, child in value.items():
                if name in properties:
                    self.validate(
                        child, properties[name], f"{location}.{name}", current_document
                    )
        elif expected == "array" and "items" in rule:
            for index, child in enumerate(value):
                self.validate(
                    child, rule["items"], f"{location}[{index}]", current_document
                )
        elif expected == "string":
            if len(value) < rule.get("minLength", 0):
                raise TodoError(f"{location}: schema minimum length is {rule['minLength']}")
            if "pattern" in rule and not re.fullmatch(rule["pattern"], value):
                raise TodoError(f"{location}: value does not match schema pattern")
            if rule.get("format") == "date":
                try:
                    dt.date.fromisoformat(value)
                except ValueError as exc:
                    raise TodoError(f"{location}: value is not a valid schema date") from exc
            elif rule.get("format") not in {None, "date"}:
                raise TodoError(
                    f"{current_document}: unsupported JSON Schema format {rule['format']!r}"
                )


@dataclass
class TaskType:
    slug: str
    label: str
    behavior: str


@dataclass
class Priority:
    order: int
    label: str


@dataclass
class DueKind:
    weight: int
    slug: str
    label: str


@dataclass
class Task:
    name: str
    completed: bool = False
    task_id: Optional[str] = None
    description: list[str] = field(default_factory=list)
    subtasks: list["Task"] = field(default_factory=list)
    due_date: Optional[str] = None
    due_time: Optional[str] = None
    due_kind: Optional[str] = None

    def ensure_ids(self) -> bool:
        changed = False
        if not self.task_id:
            self.task_id = uuid.uuid4().hex[:12]
            changed = True
        for child in self.subtasks:
            changed = child.ensure_ids() or changed
        return changed

    def has_unchecked_descendant(self) -> bool:
        return any((not child.completed) or child.has_unchecked_descendant() for child in self.subtasks)

    def carry(self) -> Optional["Task"]:
        if self.completed:
            return None
        return Task(
            name=self.name,
            completed=False,
            task_id=self.task_id,
            description=list(self.description),
            subtasks=[kept for child in self.subtasks if (kept := child.carry()) is not None],
            due_date=self.due_date,
            due_time=self.due_time,
            due_kind=self.due_kind,
        )


def task_to_dict(task: Task) -> dict[str, Any]:
    value: dict[str, Any] = {
        "id": task.task_id,
        "name": task.name,
        "completed": task.completed,
        "subtasks": [task_to_dict(child) for child in task.subtasks],
    }
    if task.description:
        value["description"] = "\n".join(task.description)
    if task.due_date:
        value["due"] = {"date": task.due_date, "kind": task.due_kind}
        if task.due_time:
            value["due"]["time"] = task.due_time
    return value


def config_lines(path: Path) -> Iterable[tuple[int, str]]:
    if not path.exists():
        raise TodoError(f"Missing configuration: {path}")
    for number, raw in enumerate(path.read_text().splitlines(), 1):
        value = raw.strip()
        if value and not value.startswith("#"):
            yield number, value


def load_types() -> list[TaskType]:
    result: list[TaskType] = []
    seen: set[str] = set()
    for number, value in config_lines(TYPES_FILE):
        parts = [part.strip() for part in value.split("|")]
        if len(parts) != 3:
            raise TodoError(f"{TYPES_FILE}:{number}: expected slug|label|behavior")
        slug, label, behavior = parts
        if not SLUG_RE.fullmatch(slug):
            raise TodoError(f"{TYPES_FILE}:{number}: invalid slug {slug!r}")
        if not label:
            raise TodoError(f"{TYPES_FILE}:{number}: label cannot be empty")
        if behavior not in {"daily", "backlog"}:
            raise TodoError(f"{TYPES_FILE}:{number}: behavior must be daily or backlog")
        if slug in seen:
            raise TodoError(f"{TYPES_FILE}:{number}: duplicate slug {slug!r}")
        seen.add(slug)
        result.append(TaskType(slug, label, behavior))
    return result


def load_priorities() -> list[Priority]:
    result: list[Priority] = []
    seen_orders: set[int] = set()
    seen_labels: set[str] = set()
    for number, value in config_lines(PRIORITIES_FILE):
        parts = [part.strip() for part in value.split("|", 1)]
        if len(parts) != 2:
            raise TodoError(f"{PRIORITIES_FILE}:{number}: expected order|label")
        try:
            order = int(parts[0])
        except ValueError as exc:
            raise TodoError(f"{PRIORITIES_FILE}:{number}: order must be an integer") from exc
        label = parts[1]
        if not label or order in seen_orders or label.casefold() in seen_labels:
            raise TodoError(f"{PRIORITIES_FILE}:{number}: duplicate or empty priority")
        seen_orders.add(order)
        seen_labels.add(label.casefold())
        result.append(Priority(order, label))
    return sorted(result, key=lambda priority: priority.order)


def load_due_kinds() -> list[DueKind]:
    path = ROOT / "config" / "due-kinds.conf"
    result: list[DueKind] = []
    seen_weights: set[int] = set()
    seen_slugs: set[str] = set()
    for number, value in config_lines(path):
        parts = [part.strip() for part in value.split("|")]
        if len(parts) != 3:
            raise TodoError(f"{path}:{number}: expected weight|slug|label")
        try:
            weight = int(parts[0])
        except ValueError as exc:
            raise TodoError(f"{path}:{number}: weight must be an integer") from exc
        slug, label = parts[1:]
        if not SLUG_RE.fullmatch(slug) or not label:
            raise TodoError(f"{path}:{number}: invalid slug or empty label")
        if weight in seen_weights or slug in seen_slugs:
            raise TodoError(f"{path}:{number}: duplicate weight or slug")
        seen_weights.add(weight)
        seen_slugs.add(slug)
        result.append(DueKind(weight, slug, label))
    return sorted(result, key=lambda item: item.weight, reverse=True)


def new_id() -> str:
    return uuid.uuid4().hex[:12]


def parse_tasks(lines: list[str], source: Path) -> list[Task]:
    roots: list[Task] = []
    stack: list[tuple[int, Task]] = []
    for line_number, line in enumerate(lines, 1):
        match = TASK_RE.match(line)
        if match:
            indent = len(match.group("indent").expandtabs(2))
            metadata: dict[str, str] = {}
            for token in (match.group("meta") or "").split():
                if ":" not in token:
                    raise TodoError(f"{source}:{line_number}: malformed task metadata {token!r}")
                key, value = token.split(":", 1)
                if key in metadata:
                    raise TodoError(f"{source}:{line_number}: duplicate metadata key {key!r}")
                metadata[key] = value
            unknown = set(metadata) - {"task", "due", "time", "due-kind"}
            if unknown:
                raise TodoError(f"{source}:{line_number}: unknown task metadata {sorted(unknown)}")
            task = Task(
                name=match.group("name").strip(),
                completed=match.group("check").lower() == "x",
                task_id=metadata.get("task"),
                due_date=metadata.get("due"),
                due_time=metadata.get("time"),
                due_kind=metadata.get("due-kind"),
            )
            while stack and stack[-1][0] >= indent:
                stack.pop()
            if stack:
                stack[-1][1].subtasks.append(task)
            else:
                roots.append(task)
            stack.append((indent, task))
        elif CHECKBOX_RE.match(line):
            raise TodoError(
                f"{source}:{line_number}: tasks must use '- [ ] **Short name**' format"
            )
        elif stack:
            stripped = line.strip()
            if stripped and not (stack[-1][1].due_date and stripped.startswith("Due: ")):
                stack[-1][1].description.append(stripped)
    return roots


def parse_daily(path: Path) -> tuple[str, dict[str, list[Task]]]:
    lines = path.read_text().splitlines()
    title = lines[0][2:].strip() if lines and lines[0].startswith("# ") else path.stem
    sections: dict[str, list[Task]] = {}
    current: Optional[str] = None
    buffer: list[str] = []
    for line in lines[1:]:
        heading = HEADING_RE.match(line)
        if heading:
            if current is not None:
                sections[current] = parse_tasks(buffer, path)
            current = heading.group(1).strip()
            buffer = []
        elif current is not None:
            buffer.append(line)
    if current is not None:
        sections[current] = parse_tasks(buffer, path)
    return title, sections


def parse_backlog(path: Path) -> list[Task]:
    lines = path.read_text().splitlines() if path.exists() else []
    return parse_tasks(lines[1:] if lines and lines[0].startswith("# ") else lines, path)


def due_display(task: Task) -> Optional[str]:
    if not task.due_date:
        return None
    parsed = dt.date.fromisoformat(task.due_date)
    value = f"{parsed.strftime('%B')} {parsed.day}, {parsed.year}"
    if task.due_time:
        parsed_time = dt.time.fromisoformat(task.due_time)
        value += f" at {parsed_time.strftime('%I:%M %p').lstrip('0')}"
    kinds = {kind.slug: kind.label for kind in load_due_kinds()}
    return f"Due: {value} — {kinds[task.due_kind]}."


def render_task(task: Task, depth: int = 0) -> list[str]:
    indent = "    " * depth
    mark = "x" if task.completed else " "
    metadata = [f"task:{task.task_id}"]
    if task.due_date:
        metadata.append(f"due:{task.due_date}")
        if task.due_time:
            metadata.append(f"time:{task.due_time}")
        metadata.append(f"due-kind:{task.due_kind}")
    lines = [f"{indent}- [{mark}] {task.name} <!-- {' '.join(metadata)} -->"]
    continuation = indent + "    "
    display = due_display(task)
    if display:
        lines.append(f"{continuation}{display}")
    for description_line in task.description:
        lines.append(f"{continuation}{description_line}")
    for child in task.subtasks:
        lines.extend(render_task(child, depth + 1))
    return lines


def render_daily(label: str, date: str, sections: dict[str, list[Task]], priorities: list[str]) -> str:
    ordered = list(priorities)
    ordered.extend(name for name in sections if name not in ordered)
    lines = [f"# {label} — {date}", ""]
    for heading in ordered:
        lines.extend([f"## {heading}", ""])
        for task in sections.get(heading, []):
            lines.extend(render_task(task))
            lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def render_backlog(label: str, tasks: list[Task]) -> str:
    lines = [f"# {label}", ""]
    for task in tasks:
        lines.extend(render_task(task))
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def ensure_valid_tree(tasks: Iterable[Task], source: Path) -> None:
    ids: set[str] = set()
    due_kinds = {kind.slug for kind in load_due_kinds()}

    def visit(task: Task) -> None:
        if not task.name or "<!--" in task.name or "\n" in task.name:
            raise TodoError(f"{source}: invalid task name {task.name!r}")
        if task.completed and task.has_unchecked_descendant():
            raise TodoError(f"{source}: completed task {task.name!r} has an unchecked subtask")
        if task.task_id:
            if not re.fullmatch(r"[0-9a-f]{12}", task.task_id):
                raise TodoError(f"{source}: invalid task id {task.task_id!r}")
            if task.task_id in ids:
                raise TodoError(f"{source}: duplicate task id {task.task_id}")
            ids.add(task.task_id)
        due_values = (task.due_date, task.due_time, task.due_kind)
        if any(due_values) and not task.due_date:
            raise TodoError(f"{source}: task {task.name!r} has due metadata without a date")
        if task.due_date:
            try:
                dt.date.fromisoformat(task.due_date)
            except ValueError as exc:
                raise TodoError(f"{source}: task {task.name!r} has an invalid due date") from exc
            if not task.due_kind:
                raise TodoError(f"{source}: task {task.name!r} needs a due kind")
            if task.due_kind not in due_kinds:
                raise TodoError(f"{source}: unknown due kind {task.due_kind!r}")
        if task.due_time:
            if not re.fullmatch(r"(?:[01]\d|2[0-3]):[0-5]\d", task.due_time):
                raise TodoError(f"{source}: task {task.name!r} has an invalid due time")
        for child in task.subtasks:
            visit(child)

    for item in tasks:
        visit(item)


def previous_day(before: str) -> Optional[Path]:
    if not TODOS_DIR.exists():
        return None
    candidates = sorted(
        path for path in TODOS_DIR.iterdir() if path.is_dir() and path.name < before
    )
    return candidates[-1] if candidates else None


def ensure_all_ids(sections: dict[str, list[Task]]) -> bool:
    changed = False
    for tasks in sections.values():
        for task in tasks:
            changed = task.ensure_ids() or changed
    return changed


def generate(date: str) -> None:
    types = load_types()
    priorities = load_priorities()
    configured_headings = [priority.label for priority in priorities]
    daily_types = {item.slug: item for item in types if item.behavior == "daily"}
    target = TODOS_DIR / date
    if target.exists() and any(target.glob("*.md")):
        validate_paths([target], fix=True)
        created: list[str] = []
        for slug, item in daily_types.items():
            path = target / f"{slug}.md"
            if not path.exists():
                path.write_text(render_daily(item.label, date, {}, configured_headings))
                created.append(path.name)
        validate_paths([target], fix=False)
        if created:
            print(f"Added missing category files to {target}: {', '.join(created)}")
        else:
            print(f"Today's TODO directory already exists: {target}")
        return

    prior_dir = previous_day(date)
    if prior_dir:
        validate_paths([prior_dir], fix=True)
    target.mkdir(parents=True, exist_ok=True)
    carried: dict[str, tuple[str, dict[str, list[Task]]]] = {}
    if prior_dir:
        for source in sorted(prior_dir.glob("*.md")):
            label, sections = parse_daily(source)
            ensure_valid_tree(
                [task for tasks in sections.values() for task in tasks], source
            )
            changed = ensure_all_ids(sections)
            if changed:
                source.write_text(render_daily(label, prior_dir.name, sections, configured_headings))
            next_sections: dict[str, list[Task]] = {}
            for heading, tasks in sections.items():
                kept = [result for task in tasks if (result := task.carry()) is not None]
                if kept:
                    next_sections[heading] = kept
            if next_sections:
                carried[source.stem] = (label.split(" — ")[0], next_sections)

    slugs = list(daily_types)
    slugs.extend(slug for slug in carried if slug not in daily_types)
    for slug in slugs:
        item = daily_types.get(slug)
        label = item.label if item else carried[slug][0]
        sections = carried.get(slug, (label, {}))[1]
        (target / f"{slug}.md").write_text(
            render_daily(label, date, sections, configured_headings)
        )
    validate_paths([target], fix=False)
    source_text = f" from {prior_dir.name}" if prior_dir else ""
    print(f"Created {target}{source_text}")


def validate_paths(paths: list[Path], fix: bool) -> None:
    priorities = [priority.label for priority in load_priorities()]
    schema = TaskSchemaValidator(SCHEMA_FILE)
    targets: list[Path] = []
    for path in paths:
        targets.extend(sorted(path.rglob("*.md")) if path.is_dir() else [path])
    for path in targets:
        if path.parent == ROOT / "backlog":
            tasks = parse_backlog(path)
            ensure_valid_tree(tasks, path)
            changed = False
            if fix:
                for task in tasks:
                    changed = task.ensure_ids() or changed
            for index, task in enumerate(tasks):
                schema.validate(task_to_dict(task), location=f"{path}:task[{index}]")
            if fix and changed:
                path.write_text(render_backlog(path.stem.title(), tasks))
        else:
            label, sections = parse_daily(path)
            ensure_valid_tree(
                [task for tasks in sections.values() for task in tasks], path
            )
            changed = ensure_all_ids(sections) if fix else False
            for heading, tasks in sections.items():
                for index, task in enumerate(tasks):
                    schema.validate(
                        task_to_dict(task), location=f"{path}:{heading}[{index}]"
                    )
            if fix and changed:
                path.write_text(render_daily(label.split(" — ")[0], path.parent.name, sections, priorities))
    print(f"Validated {len(targets)} Markdown file(s)" + (" and assigned missing IDs" if fix else ""))


def find_task(task_id: str, date: str) -> tuple[Path, Optional[str], str, dict[str, list[Task]], Task]:
    search_paths = list((TODOS_DIR / date).glob("*.md"))
    search_paths.extend((ROOT / "backlog").glob("*.md"))
    for path in search_paths:
        is_backlog = path.parent == ROOT / "backlog"
        if is_backlog:
            tasks = parse_backlog(path)
            sections = {"": tasks}
            label = path.stem.title()
        else:
            label, sections = parse_daily(path)
        stack = [task for tasks in sections.values() for task in tasks]
        while stack:
            task = stack.pop()
            if task.task_id == task_id:
                heading = next((name for name, items in sections.items() if task in items), None)
                return path, heading, label, sections, task
            stack.extend(task.subtasks)
    raise TodoError(f"No task with id {task_id!r} found for {date}")


def add_task(args: argparse.Namespace) -> None:
    date = args.date or dt.date.today().isoformat()
    types = {item.slug: item for item in load_types()}
    if args.due_time and not args.due_date:
        raise TodoError("--due-time requires --due-date")
    if args.due_date and not args.due_kind:
        raise TodoError("--due-date requires --due-kind")
    if args.due_kind and not args.due_date:
        raise TodoError("--due-kind requires --due-date")
    if args.due_kind and args.due_kind not in {kind.slug for kind in load_due_kinds()}:
        raise TodoError(f"Unknown due kind {args.due_kind!r}; use 'todo due-kinds'")

    def candidate() -> Task:
        return Task(
            args.name,
            task_id=new_id(),
            description=[args.description] if args.description else [],
            due_date=args.due_date,
            due_time=args.due_time,
            due_kind=args.due_kind,
        )

    if args.parent:
        path, _heading, label, sections, parent = find_task(args.parent, date)
        new_task = candidate()
        ensure_valid_tree([new_task], path)
        if any(child.name.casefold() == args.name.casefold() for child in parent.subtasks):
            raise TodoError(f"Duplicate subtask name under {parent.name!r}")
        parent.subtasks.append(new_task)
        if path.parent == ROOT / "backlog":
            path.write_text(render_backlog(label, sections[""]))
        else:
            path.write_text(render_daily(label.split(" — ")[0], date, sections, [p.label for p in load_priorities()]))
        print(f"Added subtask {new_task.task_id} under {parent.task_id}")
        return

    if not args.type:
        raise TodoError("--type is required unless --parent is supplied")
    if args.type not in types:
        raise TodoError(f"Unknown task type {args.type!r}; use 'todo types'")
    task_type = types[args.type]
    task = candidate()
    ensure_valid_tree([task], ROOT)
    if task_type.behavior == "backlog":
        if args.priority:
            raise TodoError("Backlog tasks do not accept a priority")
        path = ROOT / "backlog" / f"{task_type.slug}.md"
        tasks = parse_backlog(path)
        if any(item.name.casefold() == args.name.casefold() for item in tasks):
            raise TodoError(f"Duplicate task name in {path}")
        tasks.append(task)
        path.write_text(render_backlog(task_type.label, tasks))
    else:
        if not args.priority:
            raise TodoError("Daily tasks require --priority")
        generate(date)
        priorities = load_priorities()
        priority = next((p for p in priorities if p.label.casefold() == args.priority.casefold()), None)
        if not priority:
            raise TodoError(f"Unknown priority {args.priority!r}; use 'todo priorities'")
        path = TODOS_DIR / date / f"{task_type.slug}.md"
        label, sections = parse_daily(path)
        if any(item.name.casefold() == args.name.casefold() for item in sections.get(priority.label, [])):
            raise TodoError(f"Duplicate task name under {priority.label}")
        sections.setdefault(priority.label, []).append(task)
        path.write_text(render_daily(label.split(" — ")[0], date, sections, [p.label for p in priorities]))
    print(f"Added task {task.task_id}: {task.name}")


def set_completion(task_id: str, completed: bool, date: str) -> None:
    path, _heading, label, sections, task = find_task(task_id, date)
    task.completed = completed
    ensure_valid_tree([item for tasks in sections.values() for item in tasks], path)
    if path.parent == ROOT / "backlog":
        path.write_text(render_backlog(label, sections[""]))
    else:
        path.write_text(
            render_daily(
                label.split(" — ")[0],
                date,
                sections,
                [priority.label for priority in load_priorities()],
            )
        )
    state = "completed" if completed else "reopened"
    print(f"Task {task_id} {state}: {task.name}")


def list_tasks(date: str) -> None:
    target = TODOS_DIR / date
    if not target.exists():
        raise TodoError(f"No TODO directory for {date}")
    for path in sorted(target.glob("*.md")):
        label, sections = parse_daily(path)
        print(f"\n{label}")
        for heading, tasks in sections.items():
            for task in tasks:
                print(f"  [{('x' if task.completed else ' ')}] {heading}: {task.name} ({task.task_id or 'no-id'})")


def show_config(kind: str) -> None:
    if kind == "types":
        for item in load_types():
            print(f"{item.slug}\t{item.label}\t{item.behavior}")
    elif kind == "priorities":
        for item in load_priorities():
            print(f"{item.order}\t{item.label}")
    else:
        for item in load_due_kinds():
            print(f"{item.weight}\t{item.slug}\t{item.label}")


def modify_config(args: argparse.Namespace) -> None:
    if args.config_action == "list-types":
        show_config("types")
    elif args.config_action == "list-priorities":
        show_config("priorities")
    elif args.config_action == "list-due-kinds":
        show_config("due-kinds")
    elif args.config_action == "add-type":
        if not SLUG_RE.fullmatch(args.slug):
            raise TodoError("Type slug must be lowercase words separated by hyphens")
        if any(item.slug == args.slug for item in load_types()):
            raise TodoError(f"Type {args.slug!r} already exists")
        with TYPES_FILE.open("a") as handle:
            handle.write(f"{args.slug}|{args.label}|{args.behavior}\n")
        print(f"Added type {args.slug}")
    elif args.config_action == "add-priority":
        if any(item.order == args.order or item.label.casefold() == args.label.casefold() for item in load_priorities()):
            raise TodoError("Priority order and label must be unique")
        with PRIORITIES_FILE.open("a") as handle:
            handle.write(f"{args.order}|{args.label}\n")
        print(f"Added priority {args.label}")
    elif args.config_action == "add-due-kind":
        if not SLUG_RE.fullmatch(args.slug):
            raise TodoError("Due-kind slug must be lowercase words separated by hyphens")
        if any(item.weight == args.weight or item.slug == args.slug for item in load_due_kinds()):
            raise TodoError("Due-kind weight and slug must be unique")
        path = ROOT / "config" / "due-kinds.conf"
        with path.open("a") as handle:
            handle.write(f"{args.weight}|{args.slug}|{args.label}\n")
        print(f"Added due kind {args.slug}")


def export_json(date: str) -> None:
    output = []
    for path in sorted((TODOS_DIR / date).glob("*.md")):
        label, sections = parse_daily(path)

        output.append({"type": path.stem, "label": label, "priorities": {
            heading: [task_to_dict(task) for task in tasks] for heading, tasks in sections.items()
        }})
    print(json.dumps(output, indent=2))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="todo", description=__doc__)
    commands = result.add_subparsers(dest="command", required=True)

    generate_parser = commands.add_parser("generate", help="create a daily TODO directory")
    generate_parser.add_argument("--date", default=dt.date.today().isoformat())

    add_parser = commands.add_parser("add", help="add a task or subtask")
    add_parser.add_argument("name")
    add_parser.add_argument("--type")
    add_parser.add_argument("--priority")
    add_parser.add_argument("--description")
    add_parser.add_argument("--parent", help="parent task ID")
    add_parser.add_argument("--date")
    add_parser.add_argument("--due-date", help="due date in YYYY-MM-DD format")
    add_parser.add_argument("--due-time", help="optional local due time in HH:MM format")
    add_parser.add_argument("--due-kind", help="configured due-kind slug")

    list_parser = commands.add_parser("list", help="list tasks")
    list_parser.add_argument("--date", default=dt.date.today().isoformat())

    commands.add_parser("types", help="list configured task types")
    commands.add_parser("priorities", help="list configured priorities")
    commands.add_parser("due-kinds", help="list configured due-date classifications")

    complete_parser = commands.add_parser("complete", help="mark a task complete")
    complete_parser.add_argument("task_id")
    complete_parser.add_argument("--date", default=dt.date.today().isoformat())

    reopen_parser = commands.add_parser("reopen", help="mark a task incomplete")
    reopen_parser.add_argument("task_id")
    reopen_parser.add_argument("--date", default=dt.date.today().isoformat())

    validate_parser = commands.add_parser("validate", help="validate Markdown task files")
    validate_parser.add_argument("paths", nargs="*", type=Path)
    validate_parser.add_argument("--fix", action="store_true", help="assign missing task IDs")

    export_parser = commands.add_parser("export", help="export a daily list as JSON")
    export_parser.add_argument("--date", default=dt.date.today().isoformat())

    config_parser = commands.add_parser("config", help="modify configuration")
    config_commands = config_parser.add_subparsers(dest="config_action", required=True)
    config_commands.add_parser("list-types")
    config_commands.add_parser("list-priorities")
    config_commands.add_parser("list-due-kinds")
    add_type = config_commands.add_parser("add-type")
    add_type.add_argument("slug")
    add_type.add_argument("label")
    add_type.add_argument("--behavior", choices=["daily", "backlog"], default="daily")
    add_priority = config_commands.add_parser("add-priority")
    add_priority.add_argument("order", type=int)
    add_priority.add_argument("label")
    add_due_kind = config_commands.add_parser("add-due-kind")
    add_due_kind.add_argument("weight", type=int)
    add_due_kind.add_argument("slug")
    add_due_kind.add_argument("label")
    return result


def main() -> int:
    args = parser().parse_args()
    legacy_commands = {
        "generate",
        "add",
        "list",
        "complete",
        "reopen",
        "validate",
        "export",
    }
    if args.command in legacy_commands and os.environ.get("TODO_ENABLE_LEGACY") != "1":
        print(
            "error: legacy Markdown task commands are disabled; use the canonical "
            "convert, validate, render, sync, and generate commands",
            file=sys.stderr,
        )
        return 2
    try:
        if args.command == "generate":
            generate(args.date)
        elif args.command == "add":
            add_task(args)
        elif args.command == "list":
            list_tasks(args.date)
        elif args.command == "types":
            show_config("types")
        elif args.command == "priorities":
            show_config("priorities")
        elif args.command == "due-kinds":
            show_config("due-kinds")
        elif args.command == "complete":
            set_completion(args.task_id, True, args.date)
        elif args.command == "reopen":
            set_completion(args.task_id, False, args.date)
        elif args.command == "validate":
            paths = args.paths or [TODOS_DIR, ROOT / "backlog"]
            validate_paths(paths, args.fix)
        elif args.command == "export":
            export_json(args.date)
        elif args.command == "config":
            modify_config(args)
    except TodoError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
