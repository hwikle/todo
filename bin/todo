#!/usr/bin/env python3
"""Manage a local, Markdown-first daily TODO repository."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import sys
import uuid
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterable, Optional


ROOT = Path(__file__).resolve().parent.parent
TYPES_FILE = ROOT / "config" / "task-types.conf"
PRIORITIES_FILE = ROOT / "config" / "priorities.conf"
TODOS_DIR = ROOT / "todos"
TASK_RE = re.compile(
    r"^(?P<indent>\s*)- \[(?P<check>[ xX])\] \*\*(?P<name>.+?)\*\*"
    r"(?:\s+<!-- task:(?P<id>[0-9a-f]{12}) -->)?\s*$"
)
CHECKBOX_RE = re.compile(r"^\s*- \[[ xX]\]")
HEADING_RE = re.compile(r"^##\s+(.+?)\s*$")
SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")


class TodoError(Exception):
    pass


@dataclass
class TaskType:
    slug: str
    label: str
    behavior: str


@dataclass
class Priority:
    order: int
    label: str


@dataclass
class Task:
    name: str
    completed: bool = False
    task_id: Optional[str] = None
    description: list[str] = field(default_factory=list)
    subtasks: list["Task"] = field(default_factory=list)

    def ensure_ids(self) -> bool:
        changed = False
        if not self.task_id:
            self.task_id = uuid.uuid4().hex[:12]
            changed = True
        for child in self.subtasks:
            changed = child.ensure_ids() or changed
        return changed

    def has_unchecked_descendant(self) -> bool:
        return any((not child.completed) or child.has_unchecked_descendant() for child in self.subtasks)

    def carry(self) -> Optional["Task"]:
        if self.completed:
            return None
        return Task(
            name=self.name,
            completed=False,
            task_id=self.task_id,
            description=list(self.description),
            subtasks=[kept for child in self.subtasks if (kept := child.carry()) is not None],
        )


def config_lines(path: Path) -> Iterable[tuple[int, str]]:
    if not path.exists():
        raise TodoError(f"Missing configuration: {path}")
    for number, raw in enumerate(path.read_text().splitlines(), 1):
        value = raw.strip()
        if value and not value.startswith("#"):
            yield number, value


def load_types() -> list[TaskType]:
    result: list[TaskType] = []
    seen: set[str] = set()
    for number, value in config_lines(TYPES_FILE):
        parts = [part.strip() for part in value.split("|")]
        if len(parts) != 3:
            raise TodoError(f"{TYPES_FILE}:{number}: expected slug|label|behavior")
        slug, label, behavior = parts
        if not SLUG_RE.fullmatch(slug):
            raise TodoError(f"{TYPES_FILE}:{number}: invalid slug {slug!r}")
        if not label:
            raise TodoError(f"{TYPES_FILE}:{number}: label cannot be empty")
        if behavior not in {"daily", "backlog"}:
            raise TodoError(f"{TYPES_FILE}:{number}: behavior must be daily or backlog")
        if slug in seen:
            raise TodoError(f"{TYPES_FILE}:{number}: duplicate slug {slug!r}")
        seen.add(slug)
        result.append(TaskType(slug, label, behavior))
    return result


def load_priorities() -> list[Priority]:
    result: list[Priority] = []
    seen_orders: set[int] = set()
    seen_labels: set[str] = set()
    for number, value in config_lines(PRIORITIES_FILE):
        parts = [part.strip() for part in value.split("|", 1)]
        if len(parts) != 2:
            raise TodoError(f"{PRIORITIES_FILE}:{number}: expected order|label")
        try:
            order = int(parts[0])
        except ValueError as exc:
            raise TodoError(f"{PRIORITIES_FILE}:{number}: order must be an integer") from exc
        label = parts[1]
        if not label or order in seen_orders or label.casefold() in seen_labels:
            raise TodoError(f"{PRIORITIES_FILE}:{number}: duplicate or empty priority")
        seen_orders.add(order)
        seen_labels.add(label.casefold())
        result.append(Priority(order, label))
    return sorted(result, key=lambda priority: priority.order)


def new_id() -> str:
    return uuid.uuid4().hex[:12]


def parse_tasks(lines: list[str], source: Path) -> list[Task]:
    roots: list[Task] = []
    stack: list[tuple[int, Task]] = []
    for line_number, line in enumerate(lines, 1):
        match = TASK_RE.match(line)
        if match:
            indent = len(match.group("indent").expandtabs(2))
            task = Task(
                name=match.group("name").strip(),
                completed=match.group("check").lower() == "x",
                task_id=match.group("id"),
            )
            while stack and stack[-1][0] >= indent:
                stack.pop()
            if stack:
                stack[-1][1].subtasks.append(task)
            else:
                roots.append(task)
            stack.append((indent, task))
        elif CHECKBOX_RE.match(line):
            raise TodoError(
                f"{source}:{line_number}: tasks must use '- [ ] **Short name**' format"
            )
        elif stack:
            stripped = line.strip()
            if stripped:
                stack[-1][1].description.append(stripped)
    return roots


def parse_daily(path: Path) -> tuple[str, dict[str, list[Task]]]:
    lines = path.read_text().splitlines()
    title = lines[0][2:].strip() if lines and lines[0].startswith("# ") else path.stem
    sections: dict[str, list[Task]] = {}
    current: Optional[str] = None
    buffer: list[str] = []
    for line in lines[1:]:
        heading = HEADING_RE.match(line)
        if heading:
            if current is not None:
                sections[current] = parse_tasks(buffer, path)
            current = heading.group(1).strip()
            buffer = []
        elif current is not None:
            buffer.append(line)
    if current is not None:
        sections[current] = parse_tasks(buffer, path)
    return title, sections


def parse_backlog(path: Path) -> list[Task]:
    lines = path.read_text().splitlines() if path.exists() else []
    return parse_tasks(lines[1:] if lines and lines[0].startswith("# ") else lines, path)


def render_task(task: Task, depth: int = 0) -> list[str]:
    indent = "  " * depth
    mark = "x" if task.completed else " "
    lines = [f"{indent}- [{mark}] **{task.name}** <!-- task:{task.task_id} -->"]
    for description_line in task.description:
        lines.append(f"{indent}  {description_line}")
    for child in task.subtasks:
        lines.extend(render_task(child, depth + 1))
    return lines


def render_daily(label: str, date: str, sections: dict[str, list[Task]], priorities: list[str]) -> str:
    ordered = list(priorities)
    ordered.extend(name for name in sections if name not in ordered)
    lines = [f"# {label} — {date}", ""]
    for heading in ordered:
        lines.extend([f"## {heading}", ""])
        for task in sections.get(heading, []):
            lines.extend(render_task(task))
            lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def render_backlog(label: str, tasks: list[Task]) -> str:
    lines = [f"# {label}", ""]
    for task in tasks:
        lines.extend(render_task(task))
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def ensure_valid_tree(tasks: Iterable[Task], source: Path) -> None:
    ids: set[str] = set()

    def visit(task: Task) -> None:
        if task.completed and task.has_unchecked_descendant():
            raise TodoError(f"{source}: completed task {task.name!r} has an unchecked subtask")
        if task.task_id:
            if task.task_id in ids:
                raise TodoError(f"{source}: duplicate task id {task.task_id}")
            ids.add(task.task_id)
        for child in task.subtasks:
            visit(child)

    for item in tasks:
        visit(item)


def previous_day(before: str) -> Optional[Path]:
    if not TODOS_DIR.exists():
        return None
    candidates = sorted(
        path for path in TODOS_DIR.iterdir() if path.is_dir() and path.name < before
    )
    return candidates[-1] if candidates else None


def ensure_all_ids(sections: dict[str, list[Task]]) -> bool:
    changed = False
    for tasks in sections.values():
        for task in tasks:
            changed = task.ensure_ids() or changed
    return changed


def generate(date: str) -> None:
    types = load_types()
    priorities = load_priorities()
    configured_headings = [priority.label for priority in priorities]
    target = TODOS_DIR / date
    if target.exists() and any(target.glob("*.md")):
        validate_paths([target], fix=True)
        print(f"Today's TODO directory already exists: {target}")
        return

    target.mkdir(parents=True, exist_ok=True)
    prior_dir = previous_day(date)
    carried: dict[str, tuple[str, dict[str, list[Task]]]] = {}
    if prior_dir:
        for source in sorted(prior_dir.glob("*.md")):
            label, sections = parse_daily(source)
            ensure_valid_tree(
                [task for tasks in sections.values() for task in tasks], source
            )
            changed = ensure_all_ids(sections)
            if changed:
                source.write_text(render_daily(label, prior_dir.name, sections, configured_headings))
            next_sections: dict[str, list[Task]] = {}
            for heading, tasks in sections.items():
                kept = [result for task in tasks if (result := task.carry()) is not None]
                if kept:
                    next_sections[heading] = kept
            if next_sections:
                carried[source.stem] = (label.split(" — ")[0], next_sections)

    daily_types = {item.slug: item for item in types if item.behavior == "daily"}
    slugs = list(daily_types)
    slugs.extend(slug for slug in carried if slug not in daily_types)
    for slug in slugs:
        item = daily_types.get(slug)
        label = item.label if item else carried[slug][0]
        sections = carried.get(slug, (label, {}))[1]
        (target / f"{slug}.md").write_text(
            render_daily(label, date, sections, configured_headings)
        )
    validate_paths([target], fix=False)
    source_text = f" from {prior_dir.name}" if prior_dir else ""
    print(f"Created {target}{source_text}")


def validate_paths(paths: list[Path], fix: bool) -> None:
    priorities = [priority.label for priority in load_priorities()]
    targets: list[Path] = []
    for path in paths:
        targets.extend(sorted(path.rglob("*.md")) if path.is_dir() else [path])
    for path in targets:
        if path.parent == ROOT / "backlog":
            tasks = parse_backlog(path)
            ensure_valid_tree(tasks, path)
            changed = False
            for task in tasks:
                changed = task.ensure_ids() or changed
            if fix and changed:
                path.write_text(render_backlog(path.stem.title(), tasks))
        else:
            label, sections = parse_daily(path)
            ensure_valid_tree(
                [task for tasks in sections.values() for task in tasks], path
            )
            changed = ensure_all_ids(sections)
            if fix and changed:
                path.write_text(render_daily(label.split(" — ")[0], path.parent.name, sections, priorities))
    print(f"Validated {len(targets)} Markdown file(s)" + (" and assigned missing IDs" if fix else ""))


def find_task(task_id: str, date: str) -> tuple[Path, Optional[str], str, dict[str, list[Task]], Task]:
    search_paths = list((TODOS_DIR / date).glob("*.md"))
    search_paths.extend((ROOT / "backlog").glob("*.md"))
    for path in search_paths:
        is_backlog = path.parent == ROOT / "backlog"
        if is_backlog:
            tasks = parse_backlog(path)
            sections = {"": tasks}
            label = path.stem.title()
        else:
            label, sections = parse_daily(path)
        stack = [task for tasks in sections.values() for task in tasks]
        while stack:
            task = stack.pop()
            if task.task_id == task_id:
                heading = next((name for name, items in sections.items() if task in items), None)
                return path, heading, label, sections, task
            stack.extend(task.subtasks)
    raise TodoError(f"No task with id {task_id!r} found for {date}")


def add_task(args: argparse.Namespace) -> None:
    date = args.date or dt.date.today().isoformat()
    types = {item.slug: item for item in load_types()}
    if args.parent:
        path, _heading, label, sections, parent = find_task(args.parent, date)
        candidate = Task(args.name, task_id=new_id(), description=[args.description] if args.description else [])
        if any(child.name.casefold() == args.name.casefold() for child in parent.subtasks):
            raise TodoError(f"Duplicate subtask name under {parent.name!r}")
        parent.subtasks.append(candidate)
        if path.parent == ROOT / "backlog":
            path.write_text(render_backlog(label, sections[""]))
        else:
            path.write_text(render_daily(label.split(" — ")[0], date, sections, [p.label for p in load_priorities()]))
        print(f"Added subtask {candidate.task_id} under {parent.task_id}")
        return

    if not args.type:
        raise TodoError("--type is required unless --parent is supplied")
    if args.type not in types:
        raise TodoError(f"Unknown task type {args.type!r}; use 'todo types'")
    task_type = types[args.type]
    task = Task(args.name, task_id=new_id(), description=[args.description] if args.description else [])
    if task_type.behavior == "backlog":
        if args.priority:
            raise TodoError("Backlog tasks do not accept a priority")
        path = ROOT / "backlog" / f"{task_type.slug}.md"
        tasks = parse_backlog(path)
        if any(item.name.casefold() == args.name.casefold() for item in tasks):
            raise TodoError(f"Duplicate task name in {path}")
        tasks.append(task)
        path.write_text(render_backlog(task_type.label, tasks))
    else:
        if not args.priority:
            raise TodoError("Daily tasks require --priority")
        generate(date)
        priorities = load_priorities()
        priority = next((p for p in priorities if p.label.casefold() == args.priority.casefold()), None)
        if not priority:
            raise TodoError(f"Unknown priority {args.priority!r}; use 'todo priorities'")
        path = TODOS_DIR / date / f"{task_type.slug}.md"
        label, sections = parse_daily(path)
        if any(item.name.casefold() == args.name.casefold() for item in sections.get(priority.label, [])):
            raise TodoError(f"Duplicate task name under {priority.label}")
        sections.setdefault(priority.label, []).append(task)
        path.write_text(render_daily(label.split(" — ")[0], date, sections, [p.label for p in priorities]))
    print(f"Added task {task.task_id}: {task.name}")


def set_completion(task_id: str, completed: bool, date: str) -> None:
    path, _heading, label, sections, task = find_task(task_id, date)
    task.completed = completed
    ensure_valid_tree([item for tasks in sections.values() for item in tasks], path)
    if path.parent == ROOT / "backlog":
        path.write_text(render_backlog(label, sections[""]))
    else:
        path.write_text(
            render_daily(
                label.split(" — ")[0],
                date,
                sections,
                [priority.label for priority in load_priorities()],
            )
        )
    state = "completed" if completed else "reopened"
    print(f"Task {task_id} {state}: {task.name}")


def list_tasks(date: str) -> None:
    target = TODOS_DIR / date
    if not target.exists():
        raise TodoError(f"No TODO directory for {date}")
    for path in sorted(target.glob("*.md")):
        label, sections = parse_daily(path)
        print(f"\n{label}")
        for heading, tasks in sections.items():
            for task in tasks:
                print(f"  [{('x' if task.completed else ' ')}] {heading}: {task.name} ({task.task_id or 'no-id'})")


def show_config(kind: str) -> None:
    if kind == "types":
        for item in load_types():
            print(f"{item.slug}\t{item.label}\t{item.behavior}")
    else:
        for item in load_priorities():
            print(f"{item.order}\t{item.label}")


def modify_config(args: argparse.Namespace) -> None:
    if args.config_action == "list-types":
        show_config("types")
    elif args.config_action == "list-priorities":
        show_config("priorities")
    elif args.config_action == "add-type":
        if not SLUG_RE.fullmatch(args.slug):
            raise TodoError("Type slug must be lowercase words separated by hyphens")
        if any(item.slug == args.slug for item in load_types()):
            raise TodoError(f"Type {args.slug!r} already exists")
        with TYPES_FILE.open("a") as handle:
            handle.write(f"{args.slug}|{args.label}|{args.behavior}\n")
        print(f"Added type {args.slug}")
    elif args.config_action == "add-priority":
        if any(item.order == args.order or item.label.casefold() == args.label.casefold() for item in load_priorities()):
            raise TodoError("Priority order and label must be unique")
        with PRIORITIES_FILE.open("a") as handle:
            handle.write(f"{args.order}|{args.label}\n")
        print(f"Added priority {args.label}")


def export_json(date: str) -> None:
    output = []
    for path in sorted((TODOS_DIR / date).glob("*.md")):
        label, sections = parse_daily(path)

        def encode(task: Task) -> dict:
            value = {
                "id": task.task_id,
                "name": task.name,
                "completed": task.completed,
                "subtasks": [encode(child) for child in task.subtasks],
            }
            if task.description:
                value["description"] = "\n".join(task.description)
            return value

        output.append({"type": path.stem, "label": label, "priorities": {
            heading: [encode(task) for task in tasks] for heading, tasks in sections.items()
        }})
    print(json.dumps(output, indent=2))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="todo", description=__doc__)
    commands = result.add_subparsers(dest="command", required=True)

    generate_parser = commands.add_parser("generate", help="create a daily TODO directory")
    generate_parser.add_argument("--date", default=dt.date.today().isoformat())

    add_parser = commands.add_parser("add", help="add a task or subtask")
    add_parser.add_argument("name")
    add_parser.add_argument("--type")
    add_parser.add_argument("--priority")
    add_parser.add_argument("--description")
    add_parser.add_argument("--parent", help="parent task ID")
    add_parser.add_argument("--date")

    list_parser = commands.add_parser("list", help="list tasks")
    list_parser.add_argument("--date", default=dt.date.today().isoformat())

    commands.add_parser("types", help="list configured task types")
    commands.add_parser("priorities", help="list configured priorities")

    complete_parser = commands.add_parser("complete", help="mark a task complete")
    complete_parser.add_argument("task_id")
    complete_parser.add_argument("--date", default=dt.date.today().isoformat())

    reopen_parser = commands.add_parser("reopen", help="mark a task incomplete")
    reopen_parser.add_argument("task_id")
    reopen_parser.add_argument("--date", default=dt.date.today().isoformat())

    validate_parser = commands.add_parser("validate", help="validate Markdown task files")
    validate_parser.add_argument("paths", nargs="*", type=Path)
    validate_parser.add_argument("--fix", action="store_true", help="assign missing task IDs")

    export_parser = commands.add_parser("export", help="export a daily list as JSON")
    export_parser.add_argument("--date", default=dt.date.today().isoformat())

    config_parser = commands.add_parser("config", help="modify configuration")
    config_commands = config_parser.add_subparsers(dest="config_action", required=True)
    config_commands.add_parser("list-types")
    config_commands.add_parser("list-priorities")
    add_type = config_commands.add_parser("add-type")
    add_type.add_argument("slug")
    add_type.add_argument("label")
    add_type.add_argument("--behavior", choices=["daily", "backlog"], default="daily")
    add_priority = config_commands.add_parser("add-priority")
    add_priority.add_argument("order", type=int)
    add_priority.add_argument("label")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "generate":
            generate(args.date)
        elif args.command == "add":
            add_task(args)
        elif args.command == "list":
            list_tasks(args.date)
        elif args.command == "types":
            show_config("types")
        elif args.command == "priorities":
            show_config("priorities")
        elif args.command == "complete":
            set_completion(args.task_id, True, args.date)
        elif args.command == "reopen":
            set_completion(args.task_id, False, args.date)
        elif args.command == "validate":
            paths = args.paths or [TODOS_DIR, ROOT / "backlog"]
            validate_paths(paths, args.fix)
        elif args.command == "export":
            export_json(args.date)
        elif args.command == "config":
            modify_config(args)
    except TodoError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
