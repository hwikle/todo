{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/todo/browser-config.schema.json",
  "title": "Browser presentation configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "priority_colors": {
      "type": "object",
      "propertyNames": {
        "$ref": "priority.schema.json"
      },
      "additionalProperties": {
        "$ref": "#/$defs/color_pair"
      }
    }
  },
  "$defs": {
    "color_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": {
          "$ref": "#/$defs/hex_color"
        },
        "dark": {
          "$ref": "#/$defs/hex_color"
        }
      }
    },
    "hex_color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
