{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/todo/todo-list.schema.json",
  "title": "TODO list",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "tasks", "categories", "category_memberships"],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "category.schema.json"
      }
    },
    "category_memberships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category_membership"
      }
    }
  },
  "$defs": {
    "category_membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "tasks"],
      "properties": {
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tasks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "task-id.schema.json"
          }
        }
      }
    }
  }
}
