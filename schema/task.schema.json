{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/todo/task.schema.json",
  "title": "TODO task",
  "$ref": "#/$defs/task",
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "completed", "subtasks"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "subtasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        }
      }
    }
  }
}

