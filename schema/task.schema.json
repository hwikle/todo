{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/todo/task.schema.json",
  "title": "TODO task",
  "$ref": "#/$defs/task",
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "completed", "subtasks"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "due": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "kind"],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "time": {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "completed": {
          "type": "boolean"
        },
        "subtasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        }
      }
    }
  }
}
