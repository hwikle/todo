{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/todo/category.schema.json",
  "title": "TODO category",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    }
  }
}
